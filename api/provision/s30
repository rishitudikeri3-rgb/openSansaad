{"path":"s30","heading":"Settlement.","in_1996":true,"nodes_1996":[{"path":"s30","node_type":"section","number":"30","heading":"Settlement.","text":""},{"path":"s30.ss1","node_type":"subsection","number":"1","heading":null,"text":"It is not incompatible with an arbitration agreement for an arbitral tribunal to encourage settlement of the dispute and, with the agreement of the parties, the arbitral tribunal may use mediation, conciliation or other procedures at any time during the arbitral proceedings to encourage settlement."},{"path":"s30.ss2","node_type":"subsection","number":"2","heading":null,"text":"If, during arbitral proceedings, the parties settle the dispute, the arbitral tribunal shall terminate the proceedings and, if requested by the parties and not objected to by the arbitral tribunal, record the settlement in the form of an arbitral award on agreed terms."},{"path":"s30.ss3","node_type":"subsection","number":"3","heading":null,"text":"An arbitral award on agreed terms shall be made in accordance with section 31 and shall state that it is an arbitral award."},{"path":"s30.ss4","node_type":"subsection","number":"4","heading":null,"text":"An arbitral award on agreed terms shall have the same status and effect as any other arbitral award on the substance of the dispute."}],"events":[]}