{"path":"s59","heading":"Appealable orders.","in_1996":true,"nodes_1996":[{"path":"s59","node_type":"section","number":"59","heading":"Appealable orders.","text":""},{"path":"s59.ss1","node_type":"subsection","number":"1","heading":null,"text":"An appeal shall lie from the order refusing—\nto the court authorised by law to hear appeals from such order."},{"path":"s59.ss1.cl(a)","node_type":"clause","number":"a","heading":null,"text":"to refer the parties to arbitration under section 54; and"},{"path":"s59.ss1.cl(b)","node_type":"clause","number":"b","heading":null,"text":"to enforce a foreign award under section 57,"},{"path":"s59.ss2","node_type":"subsection","number":"2","heading":null,"text":"No second appeal shall lie from an order passed in appeal under this section, but nothing in this section shall affect or take away any right to appeal to the Supreme Court."}],"events":[]}