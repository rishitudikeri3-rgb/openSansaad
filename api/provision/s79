{"path":"s79","heading":"Deposits.","in_1996":true,"nodes_1996":[{"path":"s79","node_type":"section","number":"79","heading":"Deposits.","text":""},{"path":"s79.ss1","node_type":"subsection","number":"1","heading":null,"text":"The conciliator may direct each party to deposit an equal amount as an advance for the costs referred to in sub-section (2) of section 78 which he expects will be incurred."},{"path":"s79.ss2","node_type":"subsection","number":"2","heading":null,"text":"During the course of the conciliation proceedings, the conciliator may direct supplementary deposits in an equal amount from each party."},{"path":"s79.ss3","node_type":"subsection","number":"3","heading":null,"text":"If the required deposits under sub-sections (1) and (2) are not paid in full by both parties within thirty days, the conciliator may suspend the proceedings or may make a written declaration of termination of the proceedings to the parties, effective on the date of that declaration."},{"path":"s79.ss4","node_type":"subsection","number":"4","heading":null,"text":"Upon termination of the conciliation proceedings, the conciliator shall render an accounting to the parties of the deposits received and shall return any unexpended balance to the parties."}],"events":[]}