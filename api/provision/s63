{"path":"s63","heading":"Number of conciliators.","in_1996":true,"nodes_1996":[{"path":"s63","node_type":"section","number":"63","heading":"Number of conciliators.","text":""},{"path":"s63.ss1","node_type":"subsection","number":"1","heading":null,"text":"There shall be one conciliator unless the parties agree that there shall be two or three conciliators."},{"path":"s63.ss2","node_type":"subsection","number":"2","heading":null,"text":"Where there is more than one conciliator, they ought, as a general rule, to act jointly."}],"events":[]}