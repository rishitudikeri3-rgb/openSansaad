{"path":"s62","heading":"Commencement of conciliation proceedings.","in_1996":true,"nodes_1996":[{"path":"s62","node_type":"section","number":"62","heading":"Commencement of conciliation proceedings.","text":""},{"path":"s62.ss1","node_type":"subsection","number":"1","heading":null,"text":"The party initiating conciliation shall send to the other party a written invitation to conciliate under this Part, briefly identifying the subject of the dispute."},{"path":"s62.ss2","node_type":"subsection","number":"2","heading":null,"text":"Conciliation proceedings shall commence when the other party accepts in writing the invitation to conciliate."},{"path":"s62.ss3","node_type":"subsection","number":"3","heading":null,"text":"If the other party rejects the invitation, there will be no conciliation proceedings."},{"path":"s62.ss4","node_type":"subsection","number":"4","heading":null,"text":"If the party initiating conciliation does not receive a reply within thirty days from the date on which he sends the invitation, or within such other period of time as specified in the invitation, he may elect to treat this as a rejection of the invitation to conciliate and if he so elects, he shall inform in writing the other party accordingly."}],"events":[]}