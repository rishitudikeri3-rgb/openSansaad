# Copy to .env and adjust. docker-compose.yml reads the same file.

# --- Postgres ---
POSTGRES_USER=opensansad
POSTGRES_PASSWORD=opensansad
POSTGRES_DB=opensansad
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://opensansad:opensansad@localhost:5432/opensansad

# --- Neo4j (password must be >= 8 chars) ---
NEO4J_PASSWORD=opensansad-dev
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- LLMs (Phase 2+) ---
# Any OpenAI-compatible endpoint. Free options:
#   Ollama (local, no key):  LLM_BASE_URL=http://localhost:11434/v1
#   Groq (free tier):        LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini (free tier):      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter (:free models): LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
# Leave blank for Ollama
LLM_API_KEY=
# Stronger model for genealogy / intent reasoning
MODEL_REASONING=
# Cheaper / faster model for bulk extraction
MODEL_BULK=

# --- Ingestion ---
# Honest User-Agent; add a contact address before fetching anything.
USER_AGENT=OpenSansad/0.1 (academic research project; contact: <your-email>)
REQUEST_DELAY_SECONDS=1.5
DATA_DIR=data
