{"path":"s81","heading":"Admissibility of evidence in other proceedings.","in_1996":true,"nodes_1996":[{"path":"s81","node_type":"section","number":"81","heading":"Admissibility of evidence in other proceedings.","text":"The parties shall not rely on or introduce as evidence in arbitral or judicial proceedings, whether or not such proceedings relate to the dispute that is the subject of the conciliation proceedings,—"},{"path":"s81.cl(a)","node_type":"clause","number":"a","heading":null,"text":"views expressed or suggestions made by the other party in respect of a possible settlement of the dispute;"},{"path":"s81.cl(b)","node_type":"clause","number":"b","heading":null,"text":"admissions made by the other party in the course of the conciliation proceedings;"},{"path":"s81.cl(c)","node_type":"clause","number":"c","heading":null,"text":"proposals made by the conciliator;"},{"path":"s81.cl(d)","node_type":"clause","number":"d","heading":null,"text":"the fact that the other party had indicated his willingness to accept a proposal for settlement made by the conciliator."}],"events":[]}