{"path":"s22","heading":"Language.","in_1996":true,"nodes_1996":[{"path":"s22","node_type":"section","number":"22","heading":"Language.","text":""},{"path":"s22.ss1","node_type":"subsection","number":"1","heading":null,"text":"The parties are free to agree upon the language or languages to be used in the arbitral proceedings."},{"path":"s22.ss2","node_type":"subsection","number":"2","heading":null,"text":"Failing any agreement referred to in sub-section (1), the arbitral tribunal shall determine the language or languages to be used in the arbitral proceedings."},{"path":"s22.ss3","node_type":"subsection","number":"3","heading":null,"text":"The agreement or determination, unless otherwise specified, shall apply to any written statement by a party, any hearing and any arbitral award, decision or other communication by the arbitral tribunal."},{"path":"s22.ss4","node_type":"subsection","number":"4","heading":null,"text":"The arbitral tribunal may order that any documentary evidence shall be accompanied by a translation into the language or languages agreed upon by the parties or determined by the arbitral tribunal."}],"events":[]}