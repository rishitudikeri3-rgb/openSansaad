{"path":"s85","heading":"Repeal and savings.","in_1996":true,"nodes_1996":[{"path":"s85","node_type":"section","number":"85","heading":"Repeal and savings.","text":""},{"path":"s85.ss1","node_type":"subsection","number":"1","heading":null,"text":"The Arbitration (Protocol and Convention) Act, 1937, the Arbitration Act, 1940 and the Foreign Awards (Recognition and Enforcement) Act, 1961 are hereby repealed."},{"path":"s85.ss2","node_type":"subsection","number":"2","heading":null,"text":"Notwithstanding such repeal,—"},{"path":"s85.ss2.cl(a)","node_type":"clause","number":"a","heading":null,"text":"the provisions of the said enactments shall apply in relation to arbitral proceedings which commenced before this Act came into force unless otherwise agreed by the parties but this Act shall apply in relation to arbitral proceedings which commenced on or after this Act comes into force;"},{"path":"s85.ss2.cl(b)","node_type":"clause","number":"b","heading":null,"text":"all rules made and notifications published, under the said enactments shall, to the extent to which they are not repugnant to this Act, be deemed respectively to have been made or issued under this Act."}],"events":[]}