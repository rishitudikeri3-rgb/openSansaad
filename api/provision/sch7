ying the rules set out above.’."},"intent":[{"unit":"3/2016|s25","status":"not_determinable","claim":"intent not determinable from available record","tier":null,"quote":null,"document_id":null,"span":null,"attribution":null,"tiers_searched":["sor","debate","report"]}]}]}