{"path":"s42B","heading":null,"in_1996":false,"nodes_1996":[],"events":[{"instrument":"33/2019","title":"Arbitration and Conciliation (Amendment) Act, 2019 (No. 33 of 2019)","effective":"in part: ss. 1, 4–9, 11–13, 15 from 30 Aug 2019 (S.O. 3154(E)); other sections by later notification or not commenced","edges":[{"instrument":"33/2019","old":null,"new":"s42B","op_type":"insert","source":"rule","group":"33/2019|s9","confidence":1.0,"rationale":null}],"instructions":{"33/2019|s9":"After section 42 of the principal Act, the following sections shall be inserted, namely:— [[margin: Confidentiality of information.]] “42A. Notwithstanding anything contained in any other law for the time being in force, the arbitrator, the arbitral institution and the parties to the arbitration agreement shall maintain confidentiality of all arbitral proceedings except award where its disclosure is necessary for the purpose of implementation and enforcement of award. [[margin: Protection of action taken in good faith.]] 42B. No suit or other legal proceedings shall lie against the arbitrator for anything which is in good faith done or intended to be done under this Act or the rules or regulations made thereunder.”."},"intent":[{"unit":"33/2019|s9","status":"sourced","claim":"The amendment aims to protect arbitrators from suits or other legal proceedings for actions or omissions done in good faith during arbitration.","tier":"sor","quote":"to provide that the arbitrator, the arbitral institutions and the parties shall\nmaintain confidentiality of information relating to arbitral proceedings and also protect\nthe arbitrator or arbitrators from any suit or other legal proceedings for any action or\nomission done in good faith in the course of arbitration proceedings;","document_id":28,"span":[28186,28514],"attribution":{"by":"Government","role":"government","where":"Statement of Objects and Reasons, The Arbitration and Conciliation (Amendment) Bill, 2019 (as introduced in Rajya Sabha)","signed_by":"RAVI SHANKAR PRASAD"},"tiers_searched":["sor"]}]}]}