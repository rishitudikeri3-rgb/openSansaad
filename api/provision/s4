{"path":"s4","heading":"Waiver of right to object.","in_1996":true,"nodes_1996":[{"path":"s4","node_type":"section","number":"4","heading":"Waiver of right to object.","text":"A party who knows that—\nhas not been complied with and yet proceeds with the arbitration without stating his objection to such non-compliance without undue delay or, if a time limit is provided for stating that objection, within that period of time, shall be deemed to have waived his right to so object."},{"path":"s4.cl(a)","node_type":"clause","number":"a","heading":null,"text":"any provision of this Part from which the parties may derogate, or"},{"path":"s4.cl(b)","node_type":"clause","number":"b","heading":null,"text":"any requirement under the arbitration agreement,"}],"events":[]}