{"path":"s50","heading":"Appealable orders.","in_1996":true,"nodes_1996":[{"path":"s50","node_type":"section","number":"50","heading":"Appealable orders.","text":""},{"path":"s50.ss1","node_type":"subsection","number":"1","heading":null,"text":"An appeal shall lie from the order refusing to—\nto the court authorised by law to hear appeals from such order."},{"path":"s50.ss1.cl(a)","node_type":"clause","number":"a","heading":null,"text":"refer the parties to arbitration under section 45;"},{"path":"s50.ss1.cl(b)","node_type":"clause","number":"b","heading":null,"text":"enforce a foreign award under section 48,"},{"path":"s50.ss2","node_type":"subsection","number":"2","heading":null,"text":"No second appeal shall lie from an order passed in appeal under this section, but nothing in this section shall affect or take away any right to appeal to the Supreme Court."}],"events":[{"instrument":"33/2019","title":"Arbitration and Conciliation (Amendment) Act, 2019 (No. 33 of 2019)","effective":"in part: ss. 1, 4–9, 11–13, 15 from 30 Aug 2019 (S.O. 3154(E)); other sections by later notification or not commenced","edges":[{"instrument":"33/2019","old":"s50.ss1","new":"s50.ss1","op_type":"substitute","source":"rule","group":"33/2019|s12","confidence":1.0,"rationale":null}],"instructions":{"33/2019|s12":"In section 50 of the principal Act, in sub-section (1), for the words “An appeal”, the words “Notwithstanding anything contained in any other law for the time being in force, an appeal” shall be substituted."},"intent":[{"unit":"33/2019|s12","status":"not_determinable","claim":"intent not determinable from available record","tier":null,"quote":null,"document_id":null,"span":null,"attribution":null,"tiers_searched":["sor","debate","report"]}]}]}