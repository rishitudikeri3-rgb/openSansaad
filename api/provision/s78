{"path":"s78","heading":"Costs.","in_1996":true,"nodes_1996":[{"path":"s78","node_type":"section","number":"78","heading":"Costs.","text":""},{"path":"s78.ss1","node_type":"subsection","number":"1","heading":null,"text":"Upon termination of the conciliation proceedings, the conciliator shall fix the costs of the conciliation and give written notice thereof to the parties."},{"path":"s78.ss2","node_type":"subsection","number":"2","heading":null,"text":"For the purpose of sub-section (1), \"costs\" means reasonable costs relating to—"},{"path":"s78.ss2.cl(a)","node_type":"clause","number":"a","heading":null,"text":"the fee and expenses of the conciliator and witnesses requested by the conciliator with the consent of the parties;"},{"path":"s78.ss2.cl(b)","node_type":"clause","number":"b","heading":null,"text":"any expert advice requested by the conciliator with the consent of the parties;"},{"path":"s78.ss2.cl(c)","node_type":"clause","number":"c","heading":null,"text":"any assistance provided pursuant to clause (b) of sub-section (2) of section 64 and section 68;"},{"path":"s78.ss2.cl(d)","node_type":"clause","number":"d","heading":null,"text":"any other expenses incurred in connection with the conciliation proceedings and the settlement agreement."},{"path":"s78.ss3","node_type":"subsection","number":"3","heading":null,"text":"The costs shall be borne equally by the parties unless the settlement agreement provides for a different apportionment. All other expenses incurred by a party shall be borne by that party."}],"events":[]}