{"path":"s24","heading":"Hearings and written proceedings.","in_1996":true,"nodes_1996":[{"path":"s24","node_type":"section","number":"24","heading":"Hearings and written proceedings.","text":""},{"path":"s24.ss1","node_type":"subsection","number":"1","heading":null,"text":"Unless otherwise agreed by the parties, the arbitral tribunal shall decide whether to hold oral hearings for the presentation of evidence or for oral argument, or whether the proceedings shall be conducted on the basis of documents and other materials:"},{"path":"s24.ss1.p1","node_type":"proviso","number":"1","heading":null,"text":"Provided that the arbitral tribunal shall hold oral hearings, at an appropriate stage of the proceedings, on a request by a party, unless the parties have agreed that no oral hearing shall be held."},{"path":"s24.ss2","node_type":"subsection","number":"2","heading":null,"text":"The parties shall be given sufficient advance notice of any hearing and of any meeting of the arbitral tribunal for the purposes of inspection of documents, goods or other property."},{"path":"s24.ss3","node_type":"subsection","number":"3","heading":null,"text":"All statements, documents or other information supplied to, or applications made to, the arbitral tribunal by one party shall be communicated to the other party, and any expert report or evidentiary document on which the arbitral tribunal may rely in making its decision shall be communicated to the parties."}],"events":[{"instrument":"3/2016","title":"Arbitration and Conciliation (Amendment) Act, 2015 (No. 3 of 2016)","effective":"from 23 Oct 2015 (Ordinance 9 of 2015)","edges":[{"instrument":"3/2016","old":null,"new":"s24.ss1.p2","op_type":"insert","source":"rule","group":"3/2016|s12","confidence":1.0,"rationale":null}],"instructions":{"3/2016|s12":"In section 24 of the principal Act, after the proviso to sub-section (1), the following proviso shall be inserted, namely:— “Provided further that the arbitral tribunal shall, as far as possible, hold oral hearings for the presentation of evidence or for oral argument on day-to-day basis, and not grant any adjournments unless sufficient cause is made out, and may impose costs including exemplary costs on the party seeking adjournment without any sufficient cause.”."},"intent":[{"unit":"3/2016|s12","status":"not_determinable","claim":"intent not determinable from available record","tier":null,"quote":null,"document_id":null,"span":null,"attribution":null,"tiers_searched":["sor","sor","debate","report"]}]}]}