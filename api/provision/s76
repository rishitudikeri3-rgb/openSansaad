{"path":"s76","heading":"Termination of conciliation proceedings.","in_1996":true,"nodes_1996":[{"path":"s76","node_type":"section","number":"76","heading":"Termination of conciliation proceedings.","text":"The conciliation proceedings shall be terminated—"},{"path":"s76.cl(a)","node_type":"clause","number":"a","heading":null,"text":"by the signing of the settlement agreement by the parties, on the date of the agreement; or"},{"path":"s76.cl(b)","node_type":"clause","number":"b","heading":null,"text":"by a written declaration of the conciliator, after consultation with the parties, to the effect that further efforts at conciliation are no longer justified, on the date of the declaration; or"},{"path":"s76.cl(c)","node_type":"clause","number":"c","heading":null,"text":"by a written declaration of the parties addressed to the conciliator to the effect that the conciliation proceedings are terminated, on the date of the declaration; or"},{"path":"s76.cl(d)","node_type":"clause","number":"d","heading":null,"text":"by a written declaration of a party to the other party and the conciliator, if appointed, to the effect that the conciliation proceedings are terminated, on the date of the declaration."}],"events":[]}