{"path":"s8","heading":"Power to refer parties to arbitration where there is an arbitration agreement.","in_1996":true,"nodes_1996":[{"path":"s8","node_type":"section","number":"8","heading":"Power to refer parties to arbitration where there is an arbitration agreement.","text":""},{"path":"s8.ss1","node_type":"subsection","number":"1","heading":null,"text":"A judicial authority before which an action is brought in a matter which is the subject of an arbitration agreement shall, if a party so applies not later than when submitting his first statement on the substance of the dispute, refer the parties to arbitration."},{"path":"s8.ss2","node_type":"subsection","number":"2","heading":null,"text":"The application referred to in sub-section (1) shall not be entertained unless it is accompanied by the original arbitration agreement or a duly certified copy thereof."},{"path":"s8.ss3","node_type":"subsection","number":"3","heading":null,"text":"Notwithstanding that an application has been made under sub-section (1) and that the issue is pending before the judicial authority, an arbitration may be commenced or continued and an arbitral award made."}],"events":[{"instrument":"3/2016","title":"Arbitration and Conciliation (Amendment) Act, 2015 (No. 3 of 2016)","effective":"from 23 Oct 2015 (Ordinance 9 of 2015)","edges":[{"instrument":"3/2016","old":"s8.ss1","new":"s8.ss1","op_type":"substitute","source":"rule","group":"3/2016|s4.cl(i)","confidence":1.0,"rationale":null},{"instrument":"3/2016","old":null,"new":"s8.ss2.p1","op_type":"insert","source":"rule","group":"3/2016|s4.cl(ii)","confidence":1.0,"rationale":null}],"instructions":{"3/2016|s4.cl(i)":"for sub-section (1), the following sub-section shall be substituted, namely:— “(1) A judicial authority, before which an action is brought in a matter which is the subject of an arbitration agreement shall, if a party to the arbitration agreement or any person claiming through or under him, so applies not later than the date of submitting his first statement on the substance of the dispute, then, notwithstanding any judgment, decree or order of the Supreme Court or any Court, refer the parties to arbitration unless it finds that prima facie no valid arbitration agreement exists.”;","3/2016|s4.cl(ii)":"in sub-section (2), the following proviso shall be inserted, namely:— “Provided that where the original arbitration agreement or a certified copy thereof is not available with the party applying for reference to arbitration under sub-section (1), and the said agreement or certified copy is retained by the other party to that agreement, then, the party so applying shall file such application along with a copy of the arbitration agreement and a petition praying the Court to call upon the other party to produce the original arbitration agreement or its duly certified copy before that Court.”."},"intent":[{"unit":"3/2016|s4","status":"sourced","claim":"The amendments proposed in the Bill will ensure that arbitration process becomes more user-friendly, cost effective and lead to expeditious disposal of cases.","tier":"sor","quote":"The amendments proposed in the Bill will ensure that arbitration process becomes\nmore user-friendly, cost effective and lead to expeditious disposal of cases.","document_id":21,"span":[47373,47531],"attribution":{"by":"Government","role":"government","where":"Statement of Objects and Reasons, The Arbitration and Conciliation (Amendment) Bill, 2015 (as introduced)","signed_by":"D. V. SADANANDA GOWDA"},"tiers_searched":["sor"]}]}]}