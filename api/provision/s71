{"path":"s71","heading":"Co-operation of parties with conciliator.","in_1996":true,"nodes_1996":[{"path":"s71","node_type":"section","number":"71","heading":"Co-operation of parties with conciliator.","text":"The parties shall in good faith co-operate with the conciliator and, in particular, shall endeavour to comply with requests by the conciliator to submit written materials, provide evidence and attend meetings."}],"events":[]}