{"path":"s7","heading":"Arbitration agreement.","in_1996":true,"nodes_1996":[{"path":"s7","node_type":"section","number":"7","heading":"Arbitration agreement.","text":""},{"path":"s7.ss1","node_type":"subsection","number":"1","heading":null,"text":"In this Part, \"arbitration agreement\" means an agreement by the parties to submit to arbitration all or certain disputes which have arisen or which may arise between them in respect of a defined legal relationship, whether contractual or not."},{"path":"s7.ss2","node_type":"subsection","number":"2","heading":null,"text":"An arbitration agreement may be in the form of an arbitration clause in a contract or in the form of a separate agreement."},{"path":"s7.ss3","node_type":"subsection","number":"3","heading":null,"text":"An arbitration agreement shall be in writing."},{"path":"s7.ss4","node_type":"subsection","number":"4","heading":null,"text":"An arbitration agreement is in writing if it is contained in—"},{"path":"s7.ss4.cl(a)","node_type":"clause","number":"a","heading":null,"text":"a document signed by the parties;"},{"path":"s7.ss4.cl(b)","node_type":"clause","number":"b","heading":null,"text":"an exchange of letters, telex, telegrams or other means of telecommunication which provide a record of the agreement; or"},{"path":"s7.ss4.cl(c)","node_type":"clause","number":"c","heading":null,"text":"an exchange of statements of claim and defence in which the existence of the agreement is alleged by one party and not denied by the other."},{"path":"s7.ss5","node_type":"subsection","number":"5","heading":null,"text":"The reference in a contract to a document containing an arbitration clause constitutes an arbitration agreement if the contract is in writing and the reference is such as to make that arbitration clause part of the contract."}],"events":[{"instrument":"3/2016","title":"Arbitration and Conciliation (Amendment) Act, 2015 (No. 3 of 2016)","effective":"from 23 Oct 2015 (Ordinance 9 of 2015)","edges":[{"instrument":"3/2016","old":"s7.ss4.cl(b)","new":"s7.ss4.cl(b)","op_type":"insert","source":"rule","group":"3/2016|s3","confidence":1.0,"rationale":null}],"instructions":{"3/2016|s3":"In section 7 of the principal Act, in sub-section (4), in clause (b), after the words “or other means of telecommunication”, the words “including communication through electronic means” shall be inserted."},"intent":[{"unit":"3/2016|s3","status":"sourced","claim":"The amendment aims to align Indian law with the UNCITRAL Model Law and to permit arbitration agreements to be concluded through electronic communication.","tier":"report","quote":"The proposed sections 7(3A) and 7(3B) is intended to bring the\nIndian law in conformity with the UNCITRAL Model law and clarifies that an\narbitration agreement can be concluded by way of electronic communication\nas well.","document_id":59,"span":[85931,86151],"attribution":{"by":"Law Commission of India, Report No. 246","role":"committee","where":"Law Commission of India, Report No. 246: Amendments to the Arbitration and Conciliation Act, 1996 (August 2014), part 1"},"tiers_searched":["sor","debate","report"]}]}]}