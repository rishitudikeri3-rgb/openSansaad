{"path":"s80","heading":"Role of conciliator in other proceedings.","in_1996":true,"nodes_1996":[{"path":"s80","node_type":"section","number":"80","heading":"Role of conciliator in other proceedings.","text":"Unless otherwise agreed by the parties,—"},{"path":"s80.cl(a)","node_type":"clause","number":"a","heading":null,"text":"the conciliator shall not act as an arbitrator or as a representative or counsel of a party in any arbitral or judicial proceeding in respect of a dispute that is the subject of the conciliation proceedings;"},{"path":"s80.cl(b)","node_type":"clause","number":"b","heading":null,"text":"the conciliator shall not be presented by the parties as a witness in any arbitral or judicial proceedings."}],"events":[]}